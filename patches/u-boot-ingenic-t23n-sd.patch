diff --git a/include/configs/isvp_common.h b/include/configs/isvp_common.h
--- a/include/configs/isvp_common.h
+++ b/include/configs/isvp_common.h
@@ -86,3 +86,29 @@
 #define CONFIG_NETMASK 255.255.255.0
 #define CONFIG_ETHADDR 00:00:23:34:45:66
+
+/*
+ * WIFICAM T23N autonomous-SD effective override.
+ *
+ * isvp_t23.h includes this common header last.  OpenIPC's common header
+ * resets bootargs/bootcmd/env for its normal SPI/NOR firmware, so the MMC
+ * values must be re-asserted here after those definitions.
+ */
+#ifdef CONFIG_SPL_MMC_SUPPORT
+#undef CONFIG_BOOTARGS
+#undef CONFIG_BOOTCOMMAND
+#undef CONFIG_ENV_OFFSET
+#undef CONFIG_ENV_SIZE
+#undef CONFIG_ENV_SECT_SIZE
+#undef CONFIG_SYS_MONITOR_LEN
+
+#define CONFIG_BOOTARGS BOOTARGS_COMMON " root=/dev/mmcblk0p2 rootfstype=ext4 rw rootwait init=/init"
+#define CONFIG_BOOTCOMMAND "if test \"$sd_env_initialized\" != \"1\"; then setenv sd_env_initialized 1; saveenv; fi; mmc read 0x80600000 0x1800 0x3000; bootm 0x80600000"
+
+/* SPL sector 34, U-Boot sector 86, environment sector 514. */
+#define CONFIG_SYS_MONITOR_LEN (214 * 1024)
+#define CONFIG_ENV_OFFSET      0x40400
+#define CONFIG_ENV_SIZE        (32 << 10)
+#define CONFIG_ENV_SECT_SIZE   (32 << 10)
+#endif


