#!/bin/sh
set -u

CONF=/etc/wificam/wificam.conf
[ -f "$CONF" ] && . "$CONF"
WIFI_IFACE="${WIFI_IFACE:-wlan0}"
WPA_CONF="${WPA_CONF:-/data/wpa_supplicant.conf}"
WPA_BACKUP="${WPA_BACKUP:-/data/wpa_supplicant.conf.last-good}"
RECORDINGS="${RECORDINGS:-/mnt/media/recordings}"
if [ -s /var/run/wificam-media ]; then
    RECORDINGS="$(cat /var/run/wificam-media)/recordings"
fi
CSRF_FILE="${CSRF_FILE:-/var/run/wificam-csrf}"
ALLOW_REBOOT="${ALLOW_REBOOT:-0}"
AUTH_CONF="${AUTH_CONF:-/data/httpd.conf}"
SSH_PROTECT="${SSH_PROTECT:-0}"

# Optional external LLM companion: only an enable marker lives on T23N.
# Audio/LLM API keys and inference must run outside this low-RAM camera.
ASSISTANT_STATE_DIR="${SERVICE_STATE_DIR:-/opt/wificam/services}"
ASSISTANT_ENABLED_FILE="$ASSISTANT_STATE_DIR/llm_companion.enabled"
# Runtime heartbeat is volatile; a reboot must never show a stale connection.
ASSISTANT_HEARTBEAT_FILE=/var/run/wificam-llm-companion.heartbeat

REQUEST_DATA=""
if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
    IFS= read -r REQUEST_DATA || true
fi

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s///g; :a;N;$!ba;s/\n/\\n/g'
}

urldecode() {
    printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')"
}

param() {
    key="$1"
    data="${QUERY_STRING:-}"
    [ -z "$REQUEST_DATA" ] || data="$data&$REQUEST_DATA"
    # Always terminate the final field: POSIX read skips an unterminated
    # single query parameter (e.g. ?op=status), causing "unknown operation".
    printf '%s\n' "$data" | tr '&' '\n' | while IFS='=' read -r k v; do
        [ "$k" = "$key" ] && { urldecode "$v"; break; }
    done
}

header() {
    echo "Content-Type: application/json; charset=utf-8"
    echo "Cache-Control: no-store"
    echo
}

ok() {
    header
    printf '{"ok":true%s}\n' "$1"
}

fail() {
    header
    printf '{"ok":false,"error":"%s"}\n' "$(json_escape "$1")"
    exit 0
}

require_post() {
    [ "${REQUEST_METHOD:-GET}" = "POST" ] || fail "POST required"
}

require_csrf() {
    expected="$(cat "$CSRF_FILE" 2>/dev/null || true)"
    supplied="$(param csrf)"
    [ -n "$expected" ] && [ "$supplied" = "$expected" ] || fail "CSRF check failed"
}

require_auth() {
    [ -n "${REMOTE_USER:-}" ] || fail "web authentication required"
}

status() {
    host="$(hostname 2>/dev/null || echo wificam)"
    kernel="$(uname -r 2>/dev/null || echo unknown)"
    uptime_s="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)"
    ip_addr="$(ip -4 addr show "$WIFI_IFACE" 2>/dev/null | awk '/inet /{print $2; exit}')"
    gateway="$(ip route 2>/dev/null | awk '/^default /{print $3; exit}')"
    dns="$(awk '/^nameserver /{print $2; exit}' /etc/resolv.conf 2>/dev/null || true)"
    ssid="$(iw dev "$WIFI_IFACE" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID:[[:space:]]*//p' | head -n1)"
    signal="$(iw dev "$WIFI_IFACE" link 2>/dev/null | awk '/signal:/{print $2; exit}')"
    disk="$(df -k "$RECORDINGS" 2>/dev/null | awk 'NR==2{print $2","$3","$4","$5}')"
    csrf="$(cat "$CSRF_FILE" 2>/dev/null || true)"
    camera="$(wificam-camera-ctl status 2>/dev/null || echo unknown)"
    header
    printf '{"ok":true,"host":"%s","kernel":"%s","uptime":%s,"ip":"%s","gateway":"%s","dns":"%s","ssid":"%s","signal":"%s","disk":"%s","camera":"%s","csrf":"%s","user":"%s"}\n'       "$(json_escape "$host")" "$(json_escape "$kernel")" "$uptime_s"       "$(json_escape "$ip_addr")" "$(json_escape "$gateway")" "$(json_escape "$dns")"       "$(json_escape "$ssid")" "$(json_escape "$signal")" "$(json_escape "$disk")"       "$(json_escape "$camera")" "$(json_escape "$csrf")" "$(json_escape "${REMOTE_USER:-}")"
}

wifi_scan() {
    header
    printf '{"ok":true,"networks":['
    first=1
    if command -v iw >/dev/null 2>&1; then
        iw dev "$WIFI_IFACE" scan 2>/dev/null |
        awk '
          /^BSS / { if (ssid!="") print ssid "|" sig; ssid=""; sig="" }
          /^[[:space:]]*SSID:/ { sub(/^[[:space:]]*SSID:[[:space:]]*/, ""); ssid=$0 }
          /^[[:space:]]*signal:/ { sig=$2 }
          END { if (ssid!="") print ssid "|" sig }
        ' | sort -u | while IFS='|' read -r ss sig; do
            [ -n "$ss" ] || continue
            [ "$first" -eq 1 ] || printf ','
            first=0
            printf '{"ssid":"%s","signal":"%s"}' "$(json_escape "$ss")" "$(json_escape "$sig")"
        done
    fi
    printf ']}\n'
}

wifi_apply() {
    require_post
    require_csrf
    ssid="$(param ssid)"
    password="$(param password)"
    [ -n "$ssid" ] || fail "SSID is required"
    [ "${#ssid}" -le 32 ] || fail "SSID is too long"
    [ "${#password}" -ge 8 ] || fail "Wi-Fi password must be at least 8 characters"
    command -v wpa_passphrase >/dev/null 2>&1 || fail "wpa_passphrase is not installed"

    mkdir -p "$(dirname "$WPA_CONF")"
    [ -f "$WPA_CONF" ] && cp "$WPA_CONF" "$WPA_BACKUP"

    tmp="/tmp/wificam-wpa.$$"
    wpa_passphrase "$ssid" "$password" | sed '/^[[:space:]]*#psk=/d' > "$tmp" || fail "cannot create Wi-Fi profile"
    chmod 600 "$tmp"
    mv "$tmp" "$WPA_CONF"

    killall wpa_supplicant 2>/dev/null || true
    wpa_supplicant -B -i "$WIFI_IFACE" -c "$WPA_CONF" >/tmp/wificam-wpa.log 2>&1 || true
    killall udhcpc 2>/dev/null || true
    udhcpc -i "$WIFI_IFACE" -q -n -t 5 >/tmp/wificam-dhcp.log 2>&1 || true

    sleep 2
    if ip -4 addr show "$WIFI_IFACE" 2>/dev/null | grep -q 'inet '; then
        ok ',"message":"Wi-Fi profile applied"'
        exit 0
    fi

    if [ -f "$WPA_BACKUP" ]; then
        cp "$WPA_BACKUP" "$WPA_CONF"
        killall wpa_supplicant 2>/dev/null || true
        wpa_supplicant -B -i "$WIFI_IFACE" -c "$WPA_CONF" >/tmp/wificam-wpa.log 2>&1 || true
        udhcpc -i "$WIFI_IFACE" -q -n -t 5 >/tmp/wificam-dhcp.log 2>&1 || true
    fi
    fail "new network failed; rolled back to last known profile"
}

storage() {
    mkdir -p "$RECORDINGS"
    line="$(df -k "$RECORDINGS" 2>/dev/null | awk 'NR==2{print $2" "$3" "$4" "$5}')"
    set -- $line
    header
    printf '{"ok":true,"total_kb":%s,"used_kb":%s,"free_kb":%s,"use":"%s","path":"%s"}\n'       "${1:-0}" "${2:-0}" "${3:-0}" "${4:-0%}" "$(json_escape "$RECORDINGS")"
}

service_status_one() {
    svc="$1"
    raw="$(wificam-service-ctl status "$svc" 2>/dev/null || echo 'unavailable enabled=0')"
    state="$(printf '%s' "$raw" | awk '{print $1}')"
    enabled="$(printf '%s' "$raw" | sed -n 's/.*enabled=\([01]\).*/\1/p')"
    [ -n "$enabled" ] || enabled=0
    protected=0
    [ "$svc" = "ssh" ] && [ "$SSH_PROTECT" = "1" ] && protected=1
    printf '"%s":{"state":"%s","enabled":%s,"protected":%s}' "$svc" "$(json_escape "$state")" "$enabled" "$protected"
}

services() {
    header
    printf '{"ok":true,"services":{'
    service_status_one ssh
    printf ','
    service_status_one wireguard
    printf ','
    service_status_one amneziawg
    printf '}}\n'
}

service_toggle() {
    require_post
    require_csrf
    svc="$(param service)"
    enabled="$(param enabled)"
    case "$svc" in
      ssh|wireguard|amneziawg) ;;
      *) fail "unknown service" ;;
    esac
    case "$enabled" in
      1)
        out="$(wificam-service-ctl enable "$svc" 2>&1)" || fail "$out"
        ok ',"message":"service enabled"'
        ;;
      0)
        out="$(wificam-service-ctl disable "$svc" 2>&1)" || fail "$out"
        ok ',"message":"service disabled"'
        ;;
      *) fail "enabled must be 0 or 1" ;;
    esac
}

camera_action() {
    require_post
    require_csrf
    action="$1"
    out="$(wificam-camera-ctl "$action" 2>&1)"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        ok ",\"message\":\"$(json_escape "$out")\""
    else
        fail "$out"
    fi
}

web_password() {
    require_post
    # First boot is handled by setup/cgi-bin/claim. The main dashboard API
    # is served only after AUTH_CONF exists and must remain authenticated.
    [ -s "$AUTH_CONF" ] || fail "first-boot claim required"
    require_auth
    require_csrf
    password="$(param new_password)"
    [ "${#password}" -ge 10 ] || fail "new web password must be at least 10 characters"
    out="$(printf '%s' "$password" | wificam-set-web-password admin 2>&1)" || fail "$out"
    ok ',"message":"web password changed; authentication will restart"'
    (sleep 1; /etc/init.d/S90wificam restart) >/dev/null 2>&1 &
}

ptz_status() {
    command -v wificam-ptz-ctl >/dev/null 2>&1 || fail "PTZ controller not installed"
    output="$(wificam-ptz-ctl status 2>&1)" || fail "$output"
    header
    printf '%s\n' "$output"
}

ptz_action() {
    require_post
    require_auth
    require_csrf
    command -v wificam-ptz-ctl >/dev/null 2>&1 || fail "PTZ controller not installed"
    direction="$(param direction)"
    case "$direction" in left|right|up|down) ;; *) fail "invalid PTZ direction" ;; esac
    output="$(wificam-ptz-ctl move "$direction" 2>&1)" || fail "$output"
    ok ',"message":"PTZ step sent"'
}

ptz_invert() {
    require_post
    require_auth
    require_csrf
    command -v wificam-ptz-ctl >/dev/null 2>&1 || fail "PTZ controller not installed"
    axis="$(param axis)"
    value="$(param enabled)"
    case "$axis" in pan|tilt) ;; *) fail "invalid PTZ axis" ;; esac
    case "$value" in 0|1) ;; *) fail "invalid PTZ invert value" ;; esac
    output="$(wificam-ptz-ctl invert "$axis" "$value" 2>&1)" || fail "$output"
    header
    printf '%s\n' "$output"
}

ptz_autofocus() {
    require_post
    require_auth
    require_csrf
    fail "Autofocus not exposed by this camera profile; manual DW9714 focus is not autofocus"
}


# LLM mode is a declaration of consent for an external companion.
# This CGI never opens an outbound AI connection or launches a model.
assistant_status() {
    require_auth
    enabled=false
    connected=false
    state=disabled
    if [ -f "$ASSISTANT_ENABLED_FILE" ]; then
        enabled=true
        state=waiting
        now="$(date +%s 2>/dev/null || echo 0)"
        last="$(cat "$ASSISTANT_HEARTBEAT_FILE" 2>/dev/null || echo 0)"
        case "$now:$last" in
          *[!0-9:]*|:*|*:) last=0 ;;
        esac
        # A heartbeat reports a gateway, not proof that physical audio works.
        if [ "$last" -gt 0 ] 2>/dev/null && [ "$now" -ge "$last" ] 2>/dev/null &&
           [ $((now - last)) -le 90 ]; then
            connected=true
            state=bridge_online
        fi
    fi
    header
    printf '{"ok":true,"enabled":%s,"connected":%s,"state":"%s","backend":"external"}\n' \
        "$enabled" "$connected" "$state"
}

assistant_toggle() {
    require_post
    require_auth
    require_csrf
    choice="$(param enabled)"
    case "$choice" in
      1)
        umask 077
        mkdir -p "$ASSISTANT_STATE_DIR" || fail "cannot create assistant state directory"
        : > "$ASSISTANT_ENABLED_FILE" || fail "cannot enable assistant mode"
        rm -f "$ASSISTANT_HEARTBEAT_FILE"
        ;;
      0)
        rm -f "$ASSISTANT_ENABLED_FILE" "$ASSISTANT_HEARTBEAT_FILE" ||
            fail "cannot disable assistant mode"
        ;;
      *) fail "enabled must be 0 or 1" ;;
    esac
    assistant_status
}

assistant_heartbeat() {
    require_post
    require_auth
    require_csrf
    [ -f "$ASSISTANT_ENABLED_FILE" ] || fail "assistant mode is disabled"
    umask 077
    printf '%s\n' "$(date +%s)" > "$ASSISTANT_HEARTBEAT_FILE.tmp.$" ||
        fail "cannot update companion heartbeat"
    mv -f "$ASSISTANT_HEARTBEAT_FILE.tmp.$" "$ASSISTANT_HEARTBEAT_FILE" ||
        fail "cannot save companion heartbeat"
    assistant_status
}

op="$(param op)"

case "$op" in
  status) status ;;
  wifi_scan) wifi_scan ;;
  wifi_apply) wifi_apply ;;
  storage) storage ;;
  services) services ;;
  service_toggle) service_toggle ;;
  assistant_status) assistant_status ;;
  assistant_toggle) assistant_toggle ;;
  assistant_heartbeat) assistant_heartbeat ;;
  ptz_status) ptz_status ;;
  ptz_move) ptz_action ;;
  ptz_invert) ptz_invert ;;
  ptz_autofocus) ptz_autofocus ;;
  camera_start) camera_action start ;;
  camera_stop) camera_action stop ;;
  record_start) camera_action record-start ;;
  record_stop) camera_action record-stop ;;
  web_password) web_password ;;
  reboot)
    require_post
    require_csrf
    [ "$ALLOW_REBOOT" = "1" ] || fail "reboot disabled; set ALLOW_REBOOT=1 after validation"
    ok ',"message":"rebooting"'
    (sleep 1; reboot) >/dev/null 2>&1 &
    ;;
  *) fail "unknown operation" ;;
esac
