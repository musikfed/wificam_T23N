#!/bin/sh
set -eu

AUTH_CONF="${AUTH_CONF:-/opt/wificam/httpd.conf}"
USER_NAME="${1:-admin}"
WEBROOT="${WEBROOT:-/usr/share/wificam-web}"

if [ -t 0 ]; then
    echo "Usage: printf '%s' 'NEW_PASSWORD' | $0 [username]" >&2
    exit 2
fi

password="$(cat)"
[ "${#password}" -ge 10 ] || { echo "password must be at least 10 characters" >&2; exit 1; }
[ "${#password}" -le 64 ] || { echo "password must be at most 64 characters" >&2; exit 1; }
if printf '%s' "$password" | LC_ALL=C grep -q '[^!-~]'; then
    echo "password must use printable ASCII characters only (no spaces/non-ASCII)" >&2
    exit 1
fi

# BusyBox httpd accepts both plaintext and crypt(3) passwords in httpd.conf.
# On the pinned T23N/uClibc hardware image, httpd -m produced an MD5-crypt
# entry that the running httpd rejected with 401. Use the interoperable
# plaintext form by default for the LAN-only 0.1_test build. Basic Auth itself
# is plaintext-on-the-wire unless HTTPS is used, so this does not weaken the
# transport compared with the previous setup.
AUTH_PASSWORD_MODE="${AUTH_PASSWORD_MODE:-plain}"
stored="$password"

if [ "$AUTH_PASSWORD_MODE" = "md5" ]; then
    hash=""
    if command -v httpd >/dev/null 2>&1; then
        hash="$(httpd -m "$password" 2>/dev/null || true)"
    fi
    if [ -z "$hash" ] && command -v busybox >/dev/null 2>&1; then
        hash="$(busybox httpd -m "$password" 2>/dev/null || true)"
    fi
    [ -n "$hash" ] || {
        echo "BusyBox httpd MD5-crypt support (-m) is unavailable" >&2
        exit 1
    }
    stored="$hash"
elif [ "$AUTH_PASSWORD_MODE" != "plain" ]; then
    echo "AUTH_PASSWORD_MODE must be plain or md5" >&2
    exit 1
fi

mkdir -p "$(dirname "$AUTH_CONF")"
tmp="${AUTH_CONF}.new.$"
umask 077
{
    printf 'H:%s\n' "$WEBROOT"
    printf '/:%s:%s\n' "$USER_NAME" "$stored"
} > "$tmp"
mv "$tmp" "$AUTH_CONF"

echo "web authentication updated for user: $USER_NAME"
echo "restart /etc/init.d/S90wificam to apply"
