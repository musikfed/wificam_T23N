# T23N autonomous-SD U-Boot environment.
# The SD U-Boot bootcmd initializes a complete valid environment once on first boot.
# CONFIG_ENV_OFFSET = 214 KiB monitor + sector 86 * 512 = 0x40400.
# CONFIG_ENV_SIZE   = 32 KiB = 0x8000.
# Device            Device offset   Env size
/dev/mmcblk0         0x40400         0x8000
