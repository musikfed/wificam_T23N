# T23N upstream MSC0 1-bit U-Boot environment on SD.
# The pinned upstream U-Boot uses CONFIG_SYS_MONITOR_LEN = 230 KiB.
# CONFIG_ENV_OFFSET = 230 KiB + sector 86 * 512 = 0x44400 (sector 546).
# CONFIG_ENV_SIZE   = 32 KiB = 0x8000.
# Device            Device offset   Env size
/dev/mmcblk0         0x44400         0x8000
