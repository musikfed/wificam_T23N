#!/bin/sh

CONF=/etc/wificam/wificam.conf
[ -f "$CONF" ] && . "$CONF"

WEBROOT=/usr/share/wificam-web
BOOTSTRAP_WEBROOT="${BOOTSTRAP_WEBROOT:-$WEBROOT/setup}"
PIDFILE=/var/run/wificam-httpd.pid
LOG=/var/log/wificam-httpd.log
STATE_DIR="${STATE_DIR:-/opt/wificam}"
AUTH_CONF="${AUTH_CONF:-$STATE_DIR/httpd.conf}"
BOOTSTRAP_CONF="${BOOTSTRAP_CONF:-$STATE_DIR/httpd-bootstrap.conf}"
CSRF_FILE="${CSRF_FILE:-/var/run/wificam-csrf}"
ALLOW_UNAUTHENTICATED_WEB="${ALLOW_UNAUTHENTICATED_WEB:-0}"
AUTO_PROVISION_TEST_WEB_AUTH="${AUTO_PROVISION_TEST_WEB_AUTH:-0}"
DEFAULT_WEB_USER="${DEFAULT_WEB_USER:-admin}"
DEFAULT_WEB_PASSWORD="${DEFAULT_WEB_PASSWORD:-}"
WEB_PORT="${WEB_PORT:-8090}"
# Optional isolated CGI-capable BusyBox, tested before any LAN bind.
# Leave empty for normal image BusyBox. Never replace system /bin/busybox
# merely to fix the dashboard; SSH/boot use it.
WIFICAM_HTTPD_BIN="${WIFICAM_HTTPD_BIN:-}"
MEDIA_MOUNT="${MEDIA_MOUNT:-/mnt/media}"
MEDIA_FALLBACKS="${MEDIA_FALLBACKS:-/mnt/mmcblk0p1 /mnt/sdcard /mnt/sda0}"

httpd_available() {
    if [ -n "$WIFICAM_HTTPD_BIN" ]; then
        case "$WIFICAM_HTTPD_BIN" in
            /*) [ -x "$WIFICAM_HTTPD_BIN" ] || return 1 ;;
            *) echo "WIFICAM_HTTPD_BIN must be an absolute executable path" >&2; return 1 ;;
        esac
        "$WIFICAM_HTTPD_BIN" httpd -h 2>&1 | grep -qi httpd && return 0
        return 1
    fi
    command -v httpd >/dev/null 2>&1 && return 0
    busybox httpd -h 2>&1 | grep -qi httpd && return 0
    return 1
}

run_httpd() {
    if [ -n "$WIFICAM_HTTPD_BIN" ]; then
        "$WIFICAM_HTTPD_BIN" httpd "$@"
    elif command -v httpd >/dev/null 2>&1; then
        httpd "$@"
    else
        busybox httpd "$@"
    fi
}

start_httpd() {
    run_httpd "$@" >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
}

probe_get() {
    # Both clients are acceptable for the loopback-only CGI execution check.
    # Some minimal Thingino rootfs builds have BusyBox wget but no curl.
    if command -v curl >/dev/null 2>&1; then
        curl --silent --show-error --max-time 5 "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T 5 -O - "$1"
    elif busybox --list 2>/dev/null | grep -qx wget; then
        busybox wget -q -T 5 -O - "$1"
    else
        echo "WIFICAM CGI probe requires curl or wget" >&2
        return 1
    fi
}

authenticated_get() {
    url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl --silent --max-time 5 --user "$DEFAULT_WEB_USER:$DEFAULT_WEB_PASSWORD" "$url"
    elif command -v base64 >/dev/null 2>&1; then
        encoded=$(printf '%s' "$DEFAULT_WEB_USER:$DEFAULT_WEB_PASSWORD" | base64 | tr -d '\r\n')
        if command -v wget >/dev/null 2>&1; then
            wget -q -T 5 --header "Authorization: Basic $encoded" -O - "$url"
        else
            busybox wget -q -T 5 --header "Authorization: Basic $encoded" -O - "$url"
        fi
    else
        return 1
    fi
}

probe_httpd_cgi() {
    # FAIL CLOSED before binding the LAN port. A CGI-disabled BusyBox returns
    # '#!/bin/sh' literally as HTTP 200, exposing CGI script source. Probe
    # loopback only and reject any response other than actual JSON.
    probe_dir="$(mktemp -d /tmp/wificam-httpd-preflight.XXXXXX)" || return 1
    mkdir -p "$probe_dir/www/cgi-bin"
    cat > "$probe_dir/www/cgi-bin/probe" <<'EOF'
#!/bin/sh
printf 'Content-Type: application/json\r\n\r\n'
printf '{"ok":true,"cgi":"executed"}\n'
EOF
    chmod 0700 "$probe_dir/www/cgi-bin/probe"
    : > "$probe_dir/httpd.conf"
    # If port 18090 is already in use, do not mistake another service's
    # response for this probe: the child must stay running until inspected.
    run_httpd -f -p 127.0.0.1:18090 -h "$probe_dir/www"         -c "$probe_dir/httpd.conf" >"$probe_dir/httpd.log" 2>&1 &
    probe_pid=$!
    sleep 1
    probe_ok=0
    if kill -0 "$probe_pid" 2>/dev/null; then
        probe_body="$(probe_get http://127.0.0.1:18090/cgi-bin/probe 2>/dev/null || true)"
        [ "$probe_body" = '{"ok":true,"cgi":"executed"}' ] && probe_ok=1
    fi
    kill "$probe_pid" 2>/dev/null || true
    wait "$probe_pid" 2>/dev/null || true
    rm -rf "$probe_dir"
    [ "$probe_ok" = 1 ]
}

make_csrf() {
    [ -s "$CSRF_FILE" ] && return 0
    umask 077
    if [ -r /dev/urandom ] && command -v sha256sum >/dev/null 2>&1; then
        dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256sum | awk '{print $1}' > "$CSRF_FILE"
    else
        printf '%s-%s\n' "$(date +%s 2>/dev/null || echo 0)" "$$" > "$CSRF_FILE"
    fi
}

pick_media_mount() {
    # Final autonomous SD-root: mount dedicated LABEL=MEDIA if available.
    if mountpoint -q "$MEDIA_MOUNT" 2>/dev/null; then
        echo "$MEDIA_MOUNT"
        return 0
    fi

    mkdir -p "$MEDIA_MOUNT"
    if mount -L MEDIA "$MEDIA_MOUNT" 2>/dev/null; then
        echo "$MEDIA_MOUNT"
        return 0
    fi

    # Thingino/recovery fallback: reuse whichever SD mount the OS already owns.
    for p in $MEDIA_FALLBACKS; do
        if [ -d "$p" ] && mountpoint -q "$p" 2>/dev/null; then
            echo "$p"
            return 0
        fi
    done

    # UI must still start even with no writable media mounted.
    mkdir -p /tmp/wificam-media
    echo /tmp/wificam-media
}

start() {
    mkdir -p /var/run /var/log "$STATE_DIR" "$STATE_DIR/services" "$STATE_DIR/vpn"

    ACTIVE_MEDIA="$(pick_media_mount)"
    export ACTIVE_MEDIA
    printf '%s\n' "$ACTIVE_MEDIA" > /var/run/wificam-media
    RECORDINGS="$ACTIVE_MEDIA/recordings"
    SNAPSHOTS="$ACTIVE_MEDIA/snapshots"
    EVENTS="$ACTIVE_MEDIA/events"
    export RECORDINGS SNAPSHOTS EVENTS MEDIA_MOUNT="$ACTIVE_MEDIA"
    mkdir -p "$RECORDINGS" "$SNAPSHOTS" "$EVENTS" 2>/dev/null || true

    [ -x "$WEBROOT/cgi-bin/api" ] || chmod 0755 "$WEBROOT/cgi-bin/api" 2>/dev/null || true
    [ -x "$WEBROOT/cgi-bin/snapshot.jpg" ] || chmod 0755 "$WEBROOT/cgi-bin/snapshot.jpg" 2>/dev/null || true
    [ -x "$WEBROOT/cgi-bin/live.mjpg" ] || chmod 0755 "$WEBROOT/cgi-bin/live.mjpg" 2>/dev/null || true
    [ -x "$BOOTSTRAP_WEBROOT/cgi-bin/claim" ] || chmod 0755 "$BOOTSTRAP_WEBROOT/cgi-bin/claim" 2>/dev/null || true
    make_csrf

    # 0.1_test convenience: provision known LAN-only credentials once when
    # no auth file exists. Production builds set this flag to 0 and use the
    # first-boot claim page instead.
    if [ ! -s "$AUTH_CONF" ] && [ "$AUTO_PROVISION_TEST_WEB_AUTH" = "1" ] && [ -n "$DEFAULT_WEB_PASSWORD" ]; then
        printf '%s' "$DEFAULT_WEB_PASSWORD" | AUTH_CONF="$AUTH_CONF" AUTH_PASSWORD_MODE=plain \
            wificam-set-web-password "$DEFAULT_WEB_USER" >/dev/null || return 1
        echo "PegineLab WIFICAM 0.1_test credentials provisioned for user: $DEFAULT_WEB_USER"
    fi

    # BusyBox httpd reads /etc/httpd.conf by default. Thingino's stock file
    # contains H:/var/www, which would override -h and serve the Thingino UI
    # on the PegineLab port. Always pass our own config, even before auth.
    umask 077
    : > "$BOOTSTRAP_CONF"

    # Do not accept a stale PID pointing to Thingino's different web server.
    [ -f "$WEBROOT/index.html" ] &&
        grep -q 'PegineLab WIFICAM T23N' "$WEBROOT/index.html" || {
        echo "WIFICAM custom index is missing: $WEBROOT/index.html" | tee -a "$LOG" >&2
        return 1
    }
    if [ -s "$AUTH_CONF" ] && ! grep -Fqx "H:$WEBROOT" "$AUTH_CONF"; then
        echo "WIFICAM auth config has wrong H: webroot; refusing stock Thingino UI" | tee -a "$LOG" >&2
        return 1
    fi
    if [ -f "$PIDFILE" ]; then
        existing_pid=$(cat "$PIDFILE" 2>/dev/null || true)
        if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
            # Only reuse the PID when its command line contains our own webroot.
            # Never kill unrelated processes because of a stale PID file.
            command_line=$(tr '\000' ' ' < "/proc/$existing_pid/cmdline" 2>/dev/null || true)
            case "$command_line" in
                *httpd*"$WEBROOT"*) echo "PegineLab httpd already running on $WEB_PORT"; return 0 ;;
                *) echo "WIFICAM PID is owned by a different process; refusing reuse" | tee -a "$LOG" >&2; return 1 ;;
            esac
        fi
        rm -f "$PIDFILE"
    fi

    if ! httpd_available; then
        echo "WIFICAM web UI not started: BusyBox httpd applet is unavailable" | tee -a "$LOG"
        echo "Thingino integration must build BR2_PACKAGE_BUSYBOX_HTTPD=y" | tee -a "$LOG"
        return 1
    fi

    # Hardware bug 2026-11-02: target BusyBox exposed CGI sources
    # despite CONFIG_FEATURE_HTTPD_CGI=y in build-time .config.
    # Always prove actual execution *before* starting the LAN listener.
    if ! probe_httpd_cgi; then
        echo "WIFICAM CGI PRE-FLIGHT FAILED: this httpd serves scripts as files. Port $WEB_PORT stays closed." | tee -a "$LOG" >&2
        return 1
    fi

    if [ -s "$AUTH_CONF" ]; then
        echo "Starting authenticated PegineLab WIFICAM on port $WEB_PORT..."
        start_httpd -f -p "$WEB_PORT" -h "$WEBROOT" -c "$AUTH_CONF" -r "PegineLab WIFICAM T23N"
    elif [ "$ALLOW_UNAUTHENTICATED_WEB" = "1" ]; then
        if [ ! -f "$BOOTSTRAP_WEBROOT/index.html" ] || [ ! -x "$BOOTSTRAP_WEBROOT/cgi-bin/claim" ]; then
            echo "WIFICAM first-boot setup files are missing under $BOOTSTRAP_WEBROOT" | tee -a "$LOG"
            return 1
        fi
        echo "Starting PegineLab WIFICAM FIRST-BOOT CLAIM page on port $WEB_PORT..."
        # Before the admin password exists, expose only the setup-only webroot.
        # The main dashboard/API is not served unauthenticated. Passing -c is
        # mandatory so BusyBox never falls back to Thingino's /etc/httpd.conf.
        start_httpd -f -p "$WEB_PORT" -h "$BOOTSTRAP_WEBROOT" -c "$BOOTSTRAP_CONF"
    else
        echo "WIFICAM web UI not started: no $AUTH_CONF"
        echo "Set a password with:"
        echo "  printf '%s' 'NEW_PASSWORD' | wificam-set-web-password admin"
        return 0
    fi

    sleep 1
    if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "WIFICAM httpd exited during startup; see $LOG" >&2
        rm -f "$PIDFILE"
        return 1
    fi

    # Hardware regression test: 0.1_test served "#!/bin/sh" verbatim from
    # /cgi-bin/api because the cached BusyBox binary lacked functioning CGI.
    # Check authenticated JSON on the known test account. Never serve raw CGI
    # source on the network: stop our listener if this check fails.
    if [ "$AUTO_PROVISION_TEST_WEB_AUTH" = "1" ] &&
       [ -n "$DEFAULT_WEB_PASSWORD" ] &&
       grep -Fqx "/:$DEFAULT_WEB_USER:$DEFAULT_WEB_PASSWORD" "$AUTH_CONF" 2>/dev/null; then
        response="$(authenticated_get "http://127.0.0.1:$WEB_PORT/cgi-bin/api?op=status" 2>/dev/null || true)"
        case "$response" in
            '{"ok":true,'*) echo "WIFICAM CGI: status JSON verified on port $WEB_PORT" ;;
            *)
                echo "WIFICAM CGI FAILED: /cgi-bin/api did not execute as JSON; refusing to expose CGI source" | tee -a "$LOG" >&2
                stop
                return 1
                ;;
        esac
        page="$(authenticated_get "http://127.0.0.1:$WEB_PORT/" 2>/dev/null || true)"
        case "$page" in
            *'PegineLab WIFICAM T23N'*) echo "WIFICAM own page verified on $WEB_PORT" ;;
            *)
                echo "WIFICAM WRONG WEBROOT: stock or empty page on $WEB_PORT" | tee -a "$LOG" >&2
                stop
                return 1
                ;;
        esac
    fi
}

stop() {
    if [ -f "$PIDFILE" ]; then
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null || true
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
            sleep 1
            i=$((i + 1))
        done
        rm -f "$PIDFILE"
    fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
