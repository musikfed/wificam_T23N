#!/bin/sh

CONF=/etc/wificam/wificam.conf
[ -f "$CONF" ] && . "$CONF"

WEBROOT=/usr/share/wificam-web
PIDFILE=/var/run/wificam-httpd.pid
LOG=/var/log/wificam-httpd.log
AUTH_CONF="${AUTH_CONF:-/data/httpd.conf}"
CSRF_FILE="${CSRF_FILE:-/var/run/wificam-csrf}"
ALLOW_UNAUTHENTICATED_WEB="${ALLOW_UNAUTHENTICATED_WEB:-0}"
WEB_PORT="${WEB_PORT:-8080}"
MEDIA_MOUNT="${MEDIA_MOUNT:-/mnt/media}"

httpd_run() {
    if command -v httpd >/dev/null 2>&1; then
        httpd "$@"
    else
        busybox httpd "$@"
    fi
}

make_csrf() {
    [ -s "$CSRF_FILE" ] && return 0
    umask 077
    if [ -r /dev/urandom ]; then
        od -An -N16 -tx1 /dev/urandom | tr -d ' \n' > "$CSRF_FILE"
    else
        printf '%s-%s\n' "$(date +%s 2>/dev/null || echo 0)" "$$" > "$CSRF_FILE"
    fi
}

start() {
    mkdir -p /var/run /var/log /data /data/services /data/vpn "$MEDIA_MOUNT"
    mountpoint -q "$MEDIA_MOUNT" 2>/dev/null || mount -L MEDIA "$MEDIA_MOUNT" 2>/dev/null || true
    mkdir -p "$MEDIA_MOUNT/recordings" "$MEDIA_MOUNT/snapshots" "$MEDIA_MOUNT/events"

    [ -x "$WEBROOT/cgi-bin/api" ] || chmod 0755 "$WEBROOT/cgi-bin/api" 2>/dev/null || true
    make_csrf

    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        return 0
    fi

    if [ -s "$AUTH_CONF" ]; then
        echo "Starting authenticated WIFICAM web interface on port $WEB_PORT..."
        httpd_run -f -p "$WEB_PORT" -h "$WEBROOT" -c "$AUTH_CONF" -r "WIFICAM T23N" >>"$LOG" 2>&1 &
    elif [ "$ALLOW_UNAUTHENTICATED_WEB" = "1" ]; then
        echo "WARNING: starting WIFICAM bootstrap UI WITHOUT authentication on port $WEB_PORT"
        httpd_run -f -p "$WEB_PORT" -h "$WEBROOT" >>"$LOG" 2>&1 &
    else
        echo "WIFICAM web UI not started: no $AUTH_CONF"
        echo "Provision over UART:"
        echo "  printf '%s' 'NEW_PASSWORD' | wificam-set-web-password admin"
        return 0
    fi
    echo $! > "$PIDFILE"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
