#!/bin/sh

CONF=/etc/wificam/wificam.conf
[ -f "$CONF" ] && . "$CONF"

BOOT_SPLASH="${BOOT_SPLASH:-1}"
BOOT_SOUND="${BOOT_SOUND:-1}"
BOOT_BRANDING_SECONDS="${BOOT_BRANDING_SECONDS:-7}"
SPLASH=/usr/share/wificam-web/assets/peginelab-logo.png
JINGLE=/usr/share/wificam-web/assets/boot-jingle.wav

show_splash() {
    [ "$BOOT_SPLASH" = "1" ] || return 0
    [ -r "$SPLASH" ] || return 0
    [ -e /dev/fb0 ] || return 0

    if command -v fbv >/dev/null 2>&1; then
        fbv "$SPLASH" >/dev/null 2>&1 &
        p=$!
        ( sleep "$BOOT_BRANDING_SECONDS"; kill "$p" 2>/dev/null || true ) &
    elif command -v fbi >/dev/null 2>&1; then
        fbi -T 1 -noverbose -a "$SPLASH" >/dev/null 2>&1 &
        p=$!
        ( sleep "$BOOT_BRANDING_SECONDS"; kill "$p" 2>/dev/null || true ) &
    fi
}

play_jingle() {
    [ "$BOOT_SOUND" = "1" ] || return 0
    [ -r "$JINGLE" ] || return 0

    if command -v aplay >/dev/null 2>&1; then
        aplay -q "$JINGLE" >/dev/null 2>&1 &
    elif command -v tinyplay >/dev/null 2>&1; then
        tinyplay "$JINGLE" >/dev/null 2>&1 &
    fi
}

case "${1:-start}" in
  start)
    # Branding runs in background and must never delay camera/network startup.
    show_splash
    play_jingle
    ;;
  stop) ;;
  restart) "$0" start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 2 ;;
esac
